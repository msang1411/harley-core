{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "RateLimiting": {
    "Credentials": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Refresh": { "PermitLimit": 30, "WindowSeconds": 60 }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-login": {
        "ClusterId": "identity",
        "CorsPolicy": "frontend",
        "RateLimiterPolicy": "auth-credentials",
        "Match": { "Path": "/api/auth/login", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "identity-register": {
        "ClusterId": "identity",
        "CorsPolicy": "frontend",
        "RateLimiterPolicy": "auth-credentials",
        "Match": { "Path": "/api/auth/register", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "identity-refresh": {
        "ClusterId": "identity",
        "CorsPolicy": "frontend",
        "RateLimiterPolicy": "auth-refresh",
        "Match": { "Path": "/api/auth/refresh", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "identity-auth": {
        "ClusterId": "identity",
        "CorsPolicy": "frontend",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5001/" }
        }
      }
    }
  },
  "AllowedHosts": "*"
}