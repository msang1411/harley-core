{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Database": { "AutoMigrate": false },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "harley-core",
    "Audience": "harley-core-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}